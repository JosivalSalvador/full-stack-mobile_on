# Copie este arquivo para .env e ajuste os valores conforme necessário.
# .env nunca é commitado (já está no .gitignore).

# --- Aplicação ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Banco de dados ---
# Aponta para o banco ai_service_db criado por infra/postgres/init.sql
# ao subir `docker compose up -d` (ver docker-compose.yml na raiz).
DATABASE_URL=postgresql+asyncpg://ai_service_user:ai_service_dev_password@localhost:5432/ai_service_db

# --- Provider de LLM externo (Ollama Cloud) ---
# Chave gratuita: crie uma em https://ollama.com/settings/keys
# Deixe OLLAMA_HOST apontando para https://ollama.com para usar o
# tier Free na nuvem; troque para http://localhost:11434 se tiver uma
# instância local de Ollama rodando.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b

# --- Segurança interna (backend Go -> ai_service) ---
# O ai_service só vive na rede interna do Docker; o backend Go é a
# única porta de entrada da internet. Esta chave não autentica o
# usuário final (isso já é responsabilidade do backend) — é defesa em
# profundidade, confirmando que quem chama é o backend de fato.
# Gere um valor forte com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# O mesmo valor precisa estar configurado no backend Go, que o envia
# no header X-API-Key em toda chamada ao ai_service.
INTERNAL_API_KEY=

# --- Rate limiting (em memória, sem Redis) ---
# Limite de requisições por identificador de chamada dentro da janela
# de tempo abaixo. Ver app/core/security.py.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Modelo de ML ---
# Caminho para o .onnx gerado por scripts/train.py. Relativo à raiz do
# ai_service (tanto em execução local quanto dentro do container, onde
# scripts/download_models.py copia o modelo para este mesmo caminho).
MODEL_PATH=model.onnx